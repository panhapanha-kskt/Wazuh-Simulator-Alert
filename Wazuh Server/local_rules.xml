<!-- block the malicious IP address -->
<group name="attack,">

  <rule id="100200" level="10">

    <if_group>web|attack|attacks</if_group>
    <if_sid>5763</if_sid>
    <!-- Ensure srcip exists -->
    <field name="srcip">\.*</field>

    <list field="srcip" lookup="address_match_key">
      etc/lists/blacklist-alienvault
    </list>

    <description>
      IP address found in AlienVault reputation database. Block it.
    </description>

    <group>
      attack,firewall_block,authentication_failures
    </group>

  </rule>

</group>

<!-- Active Response Detection -->
<group name="active_response,firewall,">

  <rule id="100300" level="12">

    <match>firewall-drop</match>

    <description>
      Firewall drop active response executed.
    </description>

    <group>
      active_response,firewall_block,
    </group>

  </rule>

</group>
